POSTGRES_DB=pattern_detect_db
POSTGRES_USER=kostas
POSTGRES_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Upload concurrency (shared by Spring + Python). Use "auto" or an explicit integer (2-12).
UPLOAD_PARALLELISM=auto
UPLOAD_RESOURCE_PROFILE=auto

# Optional: override auto-detected host RAM (GB) when /proc/meminfo is unavailable.
# HOST_RAM_GB=16

APP_CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
